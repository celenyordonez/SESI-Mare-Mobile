{
  "expo": {
    "name": "Maré",
    "slug": "mare",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo-adaptive.png",
    "scheme": "mare",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/logo.png",
      "bundleIdentifier": "com.mare.musical"
    },
    "android": {
      "package": "com.mare.musical",
      "googleServicesFile": "./google-services.json",
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#080A10",
          "foregroundImage": "./assets/images/logo-adaptive.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/logo.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "A Maré usa suas fotos para atualizar a imagem do seu perfil e a capa.",
          "microphonePermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#080A10",
          "image": "./assets/images/logo.png",
          "imageWidth": 120
        }
      ],
      "expo-sharing",
      [
        "expo-notifications",
        {
          "color": "#58AAF0",
          "largeIcon": "./assets/images/logo-adaptive.png",
          "defaultChannel": "mare-atividade"
        }
      ],
      "./plugins/withAndroidWidgetLaunch",
      [
        "expo-widgets",
        {
          "enableAndroid": true,
          "ios": null,
          "widgets": [
            {
              "name": "MusicaDoDia",
              "displayName": "Música do dia",
              "description": "Veja a música escolhida para você hoje.",
              "android": {
                "minWidth": 160,
                "minHeight": 115,
                "targetCellWidth": 2,
                "targetCellHeight": 2,
                "resizeMode": "none"
              }
            }
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "b5212385-c661-415b-9fbf-7a5932646b53"
      }
    },
    "owner": "migs1705"
  }
}
