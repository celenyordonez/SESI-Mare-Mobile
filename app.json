{
  "expo": {
    "name": "mare",
    "slug": "mare",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo.png",
    "scheme": "mare",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/logo.png"
    },
    "android": {
      "package": "com.mare.musical",
      "adaptiveIcon": {
        "backgroundColor": "#080A10",
        "foregroundImage": "./assets/images/logo.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/logo.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "A Maré usa suas fotos para atualizar a imagem do seu perfil e a capa.",
          "microphonePermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#080A10",
          "image": "./assets/images/logo.png",
          "imageWidth": 120
        }
      ],
      "expo-sharing",
      [
        "expo-notifications",
        {
          "color": "#58AAF0",
          "defaultChannel": "mare-atividade"
        }
      ],
      "./plugins/withAndroidWidgetLaunch",
      [
        "expo-widgets",
        {
          "enableAndroid": true,
          "ios": null,
          "widgets": [
            {
              "name": "MusicaDoDia",
              "displayName": "Música do dia",
              "description": "Veja a música escolhida para você hoje.",
              "android": {
                "minWidth": 220,
                "minHeight": 160,
                "targetCellWidth": 4,
                "targetCellHeight": 3,
                "resizeMode": "horizontal"
              }
            }
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
